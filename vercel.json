{
  "buildCommand": "vite build && cp dist/index.html dist/app.html && rm -f dist/index.html",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/og.ts": {
      "includeFiles": "{dist/**,firebase-applet-config.json,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "destination": "/api/og"
    }
  ]
}
